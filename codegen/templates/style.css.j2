License: GNU General Public License v2 or later
License URI: http://www.gnu.org/licenses/gpl-2.0.html
Text Domain: {{ theme_slug | default('figma-theme') }}
Tags: {{ tags | default('custom-header, custom-menu, featured-images, full-site-editing, translation-ready') }}
*/

:root {
  --wp--preset--color--primary: {{ colors.primary | default('#0f172a') }};
  --wp--preset--color--secondary: {{ colors.secondary | default('#334155') }};
  --wp--preset--color--accent: {{ colors.accent | default('#2563eb') }};
  --wp--preset--color--background: {{ colors.background | default('#ffffff') }};
  --wp--preset--color--surface: {{ colors.surface | default('#f8fafc') }};
  --wp--preset--color--text: {{ colors.text | default('#0f172a') }};
  --wp--preset--color--muted: {{ colors.muted | default('#64748b') }};
  --wp--preset--font-family--base: {{ typography.font_family | default('system-ui, -apple-system, sans-serif') }};
  --wp--preset--spacing--base: 1rem;
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--wp--preset--font-family--base);
  color: var(--wp--preset--color--text);
  background-color: var(--wp--preset--color--background);
  line-height: 1.6;
}

.site-main {
  width: 100%;
  max-width: 1280px;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

.site-header {
  width: 100%;
  border-bottom: 1px solid #e2e8f0;
}

.main-navigation ul {
  display: flex;
  list-style: none;
  gap: 1.5rem;
  align-items: center;
}

.main-navigation a {
  text-decoration: none;
  color: inherit;
  font-weight: 500;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.5rem;
  font-weight: 600;
  text-decoration: none;
  border-radius: 0.5rem;
  border: none;
  cursor: pointer;
  transition: opacity 0.2s ease-in-out;
}

.btn-primary {
  background-color: var(--wp--preset--color--primary);
  color: #ffffff;
}

.card {
  border-radius: 0.75rem;
  background-color: var(--wp--preset--color--surface);
  border: 1px solid #e2e8f0;
  overflow: hidden;
}

.section {
  padding-top: 4rem;
  padding-bottom: 4rem;
}
